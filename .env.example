# Environment variables for Vendor-Hiring Manager Contract Management Module

PORT=4000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/assessment_db?schema=public"

# AWS S3 / LocalStack
S3_BUCKET=vendor-assessment-bucket
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Authentication
JWT_SECRET=super-secret-contract-jwt-key-32-chars-long!
JWT_EXPIRES_IN=24h

# LLM Provider Configuration (gemini or groq)
LLM_PROVIDER=gemini
LLM_API_KEY=your-api-key-here
LLM_MODEL=gemini-1.5-flash

